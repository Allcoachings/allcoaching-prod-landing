{# ============================================================
   <head> partial — used by article, news, listing templates.
   Inputs:
     post           — Post dataclass (frontmatter.py)
     site           — SiteConfig
     canonical      — full canonical URL
     hreflangs      — list of {hreflang, href}
     schemas        — list of pre-rendered JSON-LD strings
     assets_prefix  — relative path to root (e.g. "../" for /blog/x.html)
     html_lang      — e.g. "en-IN"
     og_locale      — e.g. "en_IN"
     cover_url      — absolute CDN URL or None
============================================================ #}
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="theme-color" content="{{ site.raw.brand.primary_color }}" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#15110D" media="(prefers-color-scheme: dark)" />
<meta name="color-scheme" content="light" />
<meta name="msapplication-TileColor" content="{{ site.raw.brand.primary_color }}" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="default" />
<meta name="apple-mobile-web-app-title" content="{{ site.name }}" />
<meta name="application-name" content="{{ site.name }}" />

<!-- Google Tag Manager -->
<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','{{ site.gtm_id }}');</script>

<title>{{ post.title }}</title>
<meta name="description" content="{{ post.description }}" />
{% if post.keywords %}<meta name="keywords" content="{{ post.keywords | join(', ') }}" />{% endif %}
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
<meta name="author" content="{{ author.name }}, {{ author.job_title }}, {{ site.name }}" />
<link rel="canonical" href="{{ canonical }}" />

{% for hl in hreflangs %}<link rel="alternate" hreflang="{{ hl.hreflang }}" href="{{ hl.href }}" />
{% endfor %}

<link rel="icon" type="image/webp" href="{{ assets_prefix }}assets/fevicon.webp" />
<link rel="apple-touch-icon" href="{{ assets_prefix }}assets/fevicon.webp" />
<link rel="manifest" href="/manifest.webmanifest" />

<meta property="og:title" content="{{ post.title }}" />
<meta property="og:description" content="{{ post.description }}" />
<meta property="og:type" content="article" />
<meta property="og:url" content="{{ canonical }}" />
{% if cover_url %}<meta property="og:image" content="{{ cover_url }}" />
<meta property="og:image:alt" content="{{ post.cover_image_alt or post.title }}" />
<meta property="og:image:width" content="{{ site.cover_size[0] }}" />
<meta property="og:image:height" content="{{ site.cover_size[1] }}" />{% endif %}
<meta property="article:author" content="{{ author.name }}" />
<meta property="article:published_time" content="{{ post.published.isoformat() }}" />
<meta property="article:modified_time" content="{{ (post.modified or post.published).isoformat() }}" />
<meta property="og:site_name" content="{{ site.name }}" />
<meta property="og:locale" content="{{ og_locale }}" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="{{ post.title }}" />
<meta name="twitter:description" content="{{ post.description }}" />
{% if cover_url %}<meta name="twitter:image" content="{{ cover_url }}" />{% endif %}
<meta name="twitter:site" content="{{ site.social.twitter }}" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="preconnect" href="{{ site.raw.cdn.images_base.split('/blog-images')[0] }}" crossorigin />
<link rel="dns-prefetch" href="https://www.googletagmanager.com" />
{% if cover_url %}<link rel="preload" as="image" href="{{ cover_url }}" fetchpriority="high" />{% endif %}
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;0,9..144,900;1,9..144,400;1,9..144,600;1,9..144,700;1,9..144,800&family=Instrument+Serif:ital@0;1&family=Inter+Tight:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600;6..72,700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="{{ assets_prefix }}dist/tw.min.css" />
<link rel="stylesheet" href="{{ assets_prefix }}styles.css" />
<link rel="stylesheet" href="{{ assets_prefix }}brand.css" />

{% for schema_json in schemas %}<script type="application/ld+json">{{ schema_json | safe }}</script>
{% endfor %}
